# Don't Forget — Environment Configuration
# Copy to .env and fill in. Full walkthrough: SUPABASE_SETUP.md
#
# IMPORTANT: every VITE_* value is embedded in the public browser bundle.
# Never put SUPABASE_SERVICE_ROLE_KEY (or any secret) behind a VITE_ prefix.

# Supabase project URL + anon/publishable key (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Google Analytics 4 is configured in the gtag.js snippet in index.html, not here.

# Edge Function used by Settings -> "Send Test Email"
# e.g. https://your-project-ref.supabase.co/functions/v1/send-reminder-email
VITE_NOTIFICATION_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Local testing only (never deployed, never prefixed with VITE_)
# ---------------------------------------------------------------------------
# Used by `npm run test:e2e` for user cleanup and for projects that require
# email confirmation before sign-in. Keep it in your shell, not in git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Server-side secrets used by the Edge Functions / cron worker (set with
# `supabase secrets set ...`, not here):
#   RESEND_API_KEY=re_xxxxxxxx
#   SENDER_EMAIL="Don't Forget <reminders@yourdomain.com>"
#   CRON_SECRET=some-long-random-string
