# Don't Forget — Environment Configuration

# Supabase PostgreSQL Configuration
# Get these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics 4 (GA4)
# Get this from Google Analytics Admin -> Data Streams -> Web Stream Details -> Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Email Reminder Service Endpoint / Webhook URL
# Used to dispatch scheduled email reminders (e.g., Supabase Edge Function or Webhook)
VITE_NOTIFICATION_WEBHOOK_URL=
